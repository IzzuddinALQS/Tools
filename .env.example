###############################################################################
# Oracle Data Sync — contoh konfigurasi
#
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# Di Windows PowerShell:            Copy-Item .env.example .env
#
# Lalu generate kunci aplikasi:
#     php artisan key:generate
#
# Panduan lengkap untuk mesin baru ada di SETUP-LAPTOP.md.
# Nilai di bawah disamakan dengan phpunit.xml supaya test langsung jalan.
###############################################################################

APP_NAME="Oracle Data Sync"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

###############################################################################
# Database metadata
#
# WAJIB terpisah dari PostgreSQL A dan B. Di sini tersimpan dataset, riwayat
# eksekusi, dan token API — bukan data bisnis.
###############################################################################
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ods_meta
DB_USERNAME=postgres
DB_PASSWORD=postgres

###############################################################################
# Sync
#
# mock   = Oracle tiruan dari storage/app/fixtures, untuk pengembangan & test
# oracle = Oracle asli. Hanya diisi di server, oleh IT, dengan user SELECT-only.
###############################################################################
SYNC_DEFAULT_DRIVER=mock
SYNC_FIXTURE_PATH=

###############################################################################
# Lock sinkronisasi  (PENTING)
#
# Lock ini yang mencegah satu dataset berjalan dua kali. Kalau store-nya tidak
# shared antar worker, dua worker bisa menjalankan dataset yang sama bersamaan
# dan lock tidak akan menahan siapa pun.
#
#  -  Development satu mesin  : database boleh
#  -  Produksi multi-host     : redis WAJIB
#
# Nilai ini dibaca DatasetLock lewat Cache::store(). Tidak sama dengan
# CACHE_STORE di bawah — itu untuk cache umum, yang boleh tetap di database.
###############################################################################
SYNC_LOCK_STORE=database
SYNC_LOCK_TTL_SECONDS=900

###############################################################################
# Session
#
# SESSION_ENCRYPT=false hanya untuk pengembangan, dan hanya supaya cocok dengan
# phpunit.xml. Di produksi WAJIB true: tanpa itu, session menyimpan _token,
# email, dan jejak navigasi tanpa perlindungan apa pun. Penerbitan token API
# juga akan ditolak kalau nilainya tidak true.
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

###############################################################################
# Antrean & cache
#
# QUEUE_CONNECTION wajib worker yang berjalan. API Tahap 2 memborong job ke
# antrean; tanpa worker, job menggantung selamanya.
#
# Pakai sync hanya di test.
###############################################################################
QUEUE_CONNECTION=database
CACHE_STORE=database

###############################################################################
# Proxy tepercaya
#
# WAJIB diisi kalau aplikasi berjalan di belakang reverse proxy atau load
# balancer. Isi dengan IP proxy sungguhan, dipisah koma:
#     TRUSTED_PROXIES=10.0.0.1,10.0.0.2
#
# Kenapa penting: tanpa ini $request->ip() mengembalikan IP proxy, bukan IP
# klien, sehingga pembatasan IP pada token API menilai IP yang salah. Aplikasi
# juga menolak request bertoken yang begrupai IP kalau header proxy terlihat
# tapi tidak ada proxy tepercaya — gagal tertutup yang disengaja.
#
# JANGAN isi '*'. Dengan '*', siapa pun bisa memalsukan X-Forwarded-For dan
# pembatasan IP kehilangan seluruh artinya.
#
# Kosongkan kalau aplikasi diakses langsung tanpa proxy.
###############################################################################
TRUSTED_PROXIES=

###############################################################################
# Redis  (dipakai kalau CACHE_STORE / SYNC_LOCK_STORE disetel ke redis)
###############################################################################
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Log & mail
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

MAIL_MAILER=log

###############################################################################
# Frontend
###############################################################################
VITE_APP_NAME="${APP_NAME}"

# Driver OCI8 (PHP) tidak punya variabel .env — itu extension, bukan config.
# Di mesin pengembangan tidak perlu dipasang. Di server wajib, dan kalau tidak
# tersedia, instalasi Composer perlu flag:
#     composer install --ignore-platform-req=ext-oci8